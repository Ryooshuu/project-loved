{
    "name": "loved",
    "version": "2025.0.0",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev": "bun --filter * dev",
        "build": "bun --filter * build",
        "dev:api": "bun --filter @loved/api dev",
        "build:api": "bun --filter @loved/api build",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:run": "vitest run",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix"
    },
    "devDependencies": {
        "@eslint/js": "^9.26.0",
        "@stylistic/eslint-plugin": "^4.2.0",
        "@types/bun": "latest",
        "@vitest/ui": "3.1.3",
        "eslint": "^9.26.0",
        "eslint-plugin-vue": "^10.1.0",
        "globals": "^16.0.0",
        "jiti": "^2.4.2",
        "typescript-eslint": "^8.32.0",
        "vitest": "^3.1.3"
    },
    "peerDependencies": {
        "typescript": "^5"
    }
}