{
    "name": "@loved/api",
    "type": "module",
    "private": true,
    "main": "entry.ts",
    "types": "entry.ts",
    "exports": {
        ".": "./entry.ts",
        "./*": "./src/*.ts"
    },
    "scripts": {
        "dev": "nodemon",
        "build": "tsc -p tsconfig.json"
    },
    "nodemonConfig": {
        "watch": [
            "entry.ts",
            "src"
        ],
        "ext": "ts,js,json",
        "exec": "bun entry.ts"
    },
    "devDependencies": {
        "@types/pg": "^8.15.0",
        "drizzle-kit": "^0.31.1",
        "nodemon": "^3.1.10",
        "tsc": "^2.0.4"
    },
    "dependencies": {
        "@elysiajs/cors": "^1.3.0",
        "@elysiajs/swagger": "^1.3.0",
        "drizzle-orm": "^0.43.1",
        "elysia": "^1.3.0",
        "loved": "workspace:*",
        "pg": "^8.15.6",
        "picocolors": "^1.1.1"
    }
}